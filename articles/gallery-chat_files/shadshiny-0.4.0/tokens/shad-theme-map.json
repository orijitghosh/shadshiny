{
  "$comment": "Mapping from upstream shadcn/ui theme variable names (tweakcn / registry cssVars block) to shadshiny --shad-* custom properties. Consumed by shad_theme_from_registry() in R. 'shad' values omit the '--' but keep the 'shad-' prefix as the full CSS property is '--' + value. Entries with shad:null have no shadshiny equivalent; see note.",
  "map": {
    "--background": { "shad": "shad-background" },
    "--foreground": { "shad": "shad-foreground" },
    "--card": { "shad": "shad-card" },
    "--card-foreground": { "shad": "shad-card-foreground" },
    "--popover": { "shad": "shad-popover" },
    "--popover-foreground": { "shad": "shad-popover-foreground" },
    "--primary": { "shad": "shad-primary" },
    "--primary-foreground": { "shad": "shad-primary-foreground" },
    "--secondary": { "shad": "shad-secondary" },
    "--secondary-foreground": { "shad": "shad-secondary-foreground" },
    "--muted": { "shad": "shad-muted" },
    "--muted-foreground": { "shad": "shad-muted-foreground" },
    "--accent": { "shad": "shad-accent" },
    "--accent-foreground": { "shad": "shad-accent-foreground" },
    "--destructive": { "shad": "shad-destructive" },
    "--destructive-foreground": { "shad": "shad-destructive-foreground" },
    "--border": { "shad": "shad-border" },
    "--input": { "shad": "shad-input" },
    "--ring": { "shad": "shad-ring" },
    "--chart-1": { "shad": "shad-chart-1" },
    "--chart-2": { "shad": "shad-chart-2" },
    "--chart-3": { "shad": "shad-chart-3" },
    "--chart-4": { "shad": "shad-chart-4" },
    "--chart-5": { "shad": "shad-chart-5" },
    "--sidebar": { "shad": "shad-sidebar" },
    "--sidebar-background": { "shad": "shad-sidebar", "note": "older tweakcn exports use --sidebar-background; same target" },
    "--sidebar-foreground": { "shad": "shad-sidebar-foreground" },
    "--sidebar-primary": { "shad": "shad-sidebar-primary" },
    "--sidebar-primary-foreground": { "shad": "shad-sidebar-primary-foreground" },
    "--sidebar-accent": { "shad": "shad-sidebar-accent" },
    "--sidebar-accent-foreground": { "shad": "shad-sidebar-accent-foreground" },
    "--sidebar-border": { "shad": "shad-sidebar-border" },
    "--sidebar-ring": { "shad": "shad-sidebar-ring" },
    "--radius": { "shad": "shad-radius" },
    "--font-sans": { "shad": "shad-font-sans" },
    "--font-mono": { "shad": "shad-font-mono" },
    "--font-serif": { "shad": null, "note": "shadshiny has no serif token; ignore or map to shad-font-sans manually" },
    "--radius-sm": { "shad": null, "note": "derived: shad-radius-sm = calc(--shad-radius - 4px); set --radius only" },
    "--radius-md": { "shad": null, "note": "derived from --shad-radius; set --radius only" },
    "--radius-lg": { "shad": null, "note": "derived from --shad-radius; set --radius only" },
    "--radius-xl": { "shad": null, "note": "derived from --shad-radius; set --radius only" },
    "--shadow-2xs": { "shad": "shad-shadow-2xs" },
    "--shadow-xs": { "shad": "shad-shadow-xs" },
    "--shadow-sm": { "shad": "shad-shadow-sm" },
    "--shadow": { "shad": "shad-shadow-sm", "note": "upstream unsuffixed --shadow maps to the sm step" },
    "--shadow-md": { "shad": "shad-shadow-md" },
    "--shadow-lg": { "shad": "shad-shadow-lg" },
    "--shadow-xl": { "shad": "shad-shadow-xl" },
    "--shadow-2xl": { "shad": null, "note": "shadshiny shadow scale ends at xl" },
    "--shadow-color": { "shad": null, "note": "tweakcn decomposed shadow var; shadshiny shadows are literal values" },
    "--shadow-opacity": { "shad": null, "note": "tweakcn decomposed shadow var" },
    "--shadow-blur": { "shad": null, "note": "tweakcn decomposed shadow var" },
    "--shadow-spread": { "shad": null, "note": "tweakcn decomposed shadow var" },
    "--shadow-offset-x": { "shad": null, "note": "tweakcn decomposed shadow var" },
    "--shadow-offset-y": { "shad": null, "note": "tweakcn decomposed shadow var" },
    "--letter-spacing": { "shad": null, "note": "no global tracking token in shadshiny" },
    "--spacing": { "shad": null, "note": "shadshiny ships a fixed 4px-grid --shad-space-* scale, not a unit multiplier" }
  },
  "shadOnly": {
    "$comment": "shadshiny tokens with no upstream shadcn cssVars equivalent (set by shadshiny, not importable from a registry theme)",
    "tokens": ["shad-chart-6", "shad-chart-grid", "shad-chart-label", "shad-overlay", "shad-focus-shadow", "shad-focus-shadow-destructive", "shad-radius-full", "shad-text-*", "shad-leading-*", "shad-font-weight-*", "shad-space-*", "shad-duration-*", "shad-ease-*"]
  }
}
